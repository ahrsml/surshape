proc.nat.spec_blur.desc = Promedia el espectro en el tiempo: los cambios se funden y el sonido se vuelve una nube difusa.
# [TÉRMINO] gate
proc.nat.spec_gate.nombre = Compuerta espectral
proc.nat.spec_gate.desc = Silencia las frecuencias más débiles de cada instante y deja solo las fuertes (o al revés: solo el residuo).
proc.nat.spec_shift.nombre = Desplazar espectro
proc.nat.spec_shift.desc = Suma una cantidad fija de hercios a todas las frecuencias: los armónicos dejan de ser armónicos y el sonido se vuelve metálico.
proc.nat.spec_stretch.nombre = Estirar espectro
proc.nat.spec_stretch.desc = Separa (o junta) las frecuencias por encima de un ancla: timbres inarmónicos, campanas, distorsión de la afinación interna.
# [TÉRMINO] bins
proc.nat.bin_shuffle.nombre = Barajar bins
proc.nat.bin_shuffle.desc = Intercambia al azar bloques de frecuencias en cada cuadro: el sonido se descompone en un mosaico tonal.
# [TÉRMINO] robotize
proc.nat.robotize.nombre = Robotizar
proc.nat.robotize.desc = Impone una altura fija: anula las fases y repite cada cuadro una vez por período. Voz de robot, zumbido tonal.
# [TÉRMINO] whisperize
proc.nat.whisperize.nombre = Susurrar
proc.nat.whisperize.desc = Reemplaza las fases por azar con ventanas cortas: se pierde la altura y queda un susurro con el timbre original.

# [TÉRMINO] blur blur (nombre del programa CDP)
proc.cdp.blur_blur.nombre = Desenfoque
proc.cdp.blur_blur.desc = Promedia el espectro sobre varias ventanas de análisis: suaviza los cambios y vuelve el sonido difuso. Programa CDP: blur blur.
# [TÉRMINO] focus accu (nombre del programa CDP)
proc.cdp.focus_accu.nombre = Acumular espectro
proc.cdp.focus_accu.desc = Sostiene cada banda de frecuencia hasta que aparece algo más fuerte en ella: estelas, resonancias que no se apagan. Programa CDP: focus accu.
# [TÉRMINO] focus exag (nombre del programa CDP)
proc.cdp.focus_exag.nombre = Exagerar contorno
proc.cdp.focus_exag.desc = Exagera la forma del espectro: los picos se afilan y los valles se ahondan, o al revés. Programa CDP: focus exag.
# [TÉRMINO] hilite trace (nombre del programa CDP)
proc.cdp.hilite_trace.nombre = Rastrear parciales
proc.cdp.hilite_trace.desc = Conserva solo los N componentes más fuertes de cada ventana: el sonido se reduce a su esqueleto tonal. Programa CDP: hilite trace.
# [TÉRMINO] stretch time (nombre del programa CDP)
proc.cdp.stretch_time.nombre = Estirar en el tiempo
proc.cdp.stretch_time.desc = Estira o comprime la duración sin cambiar la altura, con el vocoder de fase de CDP. Programa CDP: stretch time.
# [TÉRMINO] distort repeat (nombre del programa CDP)
proc.cdp.distort_repeat.nombre = Repetir ciclos
proc.cdp.distort_repeat.desc = Repite cada ciclo de onda (o grupo de ciclos) varias veces: alarga el sonido con una textura granulada y tartamuda. Programa CDP: distort repeat.
# [TÉRMINO] distort fractal (nombre del programa CDP)
proc.cdp.distort_fractal.nombre = Fractal de ciclos
proc.cdp.distort_fractal.desc = Superpone copias en miniatura de cada ciclo de onda sobre sí mismo: brillo agresivo, distorsión fractal. Programa CDP: distort fractal.
# [TÉRMINO] extend zigzag (nombre del programa CDP)
proc.cdp.extend_zigzag.nombre = Zigzag
proc.cdp.extend_zigzag.desc = Lee el sonido hacia adelante y hacia atrás al azar dentro de un tramo, hasta la duración pedida. Reproducible con la seed. Programa CDP: extend zigzag.

# [TÉRMINO] LFSR
proc.nat.noise.nombre = Ruido
proc.nat.noise.desc = Genera ruido sin entrada: blanco, rosa, marrón, polvo (clics dispersos) o LFSR (digital, estilo NES). Reproducible con la seed.
proc.nat.granular.nombre = Granular
proc.nat.granular.desc = Arma el resultado con muchos granos cortos leídos de la entrada: nubes, texturas, congelados que respiran.
proc.nat.convolve.nombre = Convolución
proc.nat.convolve.desc = Usa otra celda como respuesta al impulso: reverberación de un espacio real o híbridos de timbre entre dos sonidos.
proc.nat.cross_synth.nombre = Síntesis cruzada
proc.nat.cross_synth.desc = Aplica el timbre (amplitudes o envolvente espectral) de otra celda sobre el sonido de esta: una voz que habla con el ruido del viento.
# [TÉRMINO] combine cross
proc.cdp.combine_cross.nombre = Cruce espectral
proc.cdp.combine_cross.desc = Reemplaza las amplitudes espectrales de la entrada por las de la segunda entrada. Programa CDP: combine cross.
# [TÉRMINO] morph
proc.cdp.morph_morph.nombre = Morph
proc.cdp.morph_morph.desc = Transforma gradualmente un espectro en otro, en amplitud y en frecuencia. Programa CDP: morph morph.

proc.nat.band_split.nombre = Dividir en bandas
proc.nat.band_split.desc = Reparte el sonido en varias bandas de frecuencia; cada banda es una salida y abre su propia fila. Sumadas, dan el original.

