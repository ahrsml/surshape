# --- Fase 6: ampliación del catálogo CDP ---
proc.cdp.blur_avrg.nombre = Promediar canales
proc.cdp.blur_avrg.desc = Promedia la energía de cada canal del análisis con sus vecinos: espectro más liso y difuso. Programa CDP: blur avrg.
param.cdp.blur_avrg.n = Canales
param.cdp.blur_avrg.n.desc = Cuántos canales vecinos se promedian (se usa un número impar).
proc.cdp.blur_suppress.nombre = Suprimir parciales
proc.cdp.blur_suppress.desc = Quita en cada ventana los N parciales más fuertes: queda el fondo, el aire, el ruido. Programa CDP: blur suppress.
param.cdp.blur_suppress.n = Parciales
param.cdp.blur_suppress.n.desc = Cuántos de los parciales más fuertes se quitan.
proc.cdp.strange_shift.nombre = Desplazar frecuencias
proc.cdp.strange_shift.desc = Suma una cantidad fija de Hz a las frecuencias (todo el espectro o una parte): sonidos inarmónicos y metálicos. Programa CDP: strange shift.
param.cdp.strange_shift.modo = Modo
param.cdp.strange_shift.modo.desc = Qué parte del espectro se desplaza.
param.cdp.strange_shift.modo.1 = Todo el espectro
param.cdp.strange_shift.modo.2 = Por encima de la división
param.cdp.strange_shift.modo.3 = Por debajo de la división
param.cdp.strange_shift.modo.4 = Dentro de un rango
param.cdp.strange_shift.modo.5 = Fuera de un rango
param.cdp.strange_shift.desplazamiento = Desplazamiento
param.cdp.strange_shift.desplazamiento.desc = Hz que se suman (negativos: hacia abajo).
param.cdp.strange_shift.division = División
param.cdp.strange_shift.division.desc = Frecuencia donde empieza o termina el desplazamiento.
param.cdp.strange_shift.desde = Desde
param.cdp.strange_shift.desde.desc = Comienzo del rango.
param.cdp.strange_shift.hasta = Hasta
param.cdp.strange_shift.hasta.desc = Final del rango.
proc.cdp.stretch_spectrum.nombre = Estirar parciales
proc.cdp.stretch_spectrum.desc = Separa o junta los parciales por encima o por debajo de una frecuencia: armónicos que se vuelven campanas. Programa CDP: stretch spectrum.
param.cdp.stretch_spectrum.modo = Modo
param.cdp.stretch_spectrum.modo.desc = Qué parte del espectro se estira.
param.cdp.stretch_spectrum.modo.1 = Por encima de la división
param.cdp.stretch_spectrum.modo.2 = Por debajo de la división
param.cdp.stretch_spectrum.division = División
param.cdp.stretch_spectrum.division.desc = Frecuencia desde donde se estira.
param.cdp.stretch_spectrum.maximo = Estiramiento máximo
param.cdp.stretch_spectrum.maximo.desc = Transposición de los parciales más altos (1 = sin cambio).
param.cdp.stretch_spectrum.exponente = Exponente
param.cdp.stretch_spectrum.exponente.desc = Forma del estiramiento (1 = parejo).
param.cdp.stretch_spectrum.profundidad = Profundidad
param.cdp.stretch_spectrum.profundidad.desc = Cuánto del efecto se aplica (0 a 1).
proc.cdp.focus_fold.nombre = Plegar espectro
proc.cdp.focus_fold.desc = Transpone por octavas todos los componentes para que caigan dentro de un rango: una masa densa en un registro. Programa CDP: focus fold.
param.cdp.focus_fold.desde = Desde
param.cdp.focus_fold.desde.desc = Frecuencia baja del rango (como mínimo una octava hasta la alta).
param.cdp.focus_fold.hasta = Hasta
param.cdp.focus_fold.hasta.desc = Frecuencia alta del rango.
proc.cdp.hilite_filter.nombre = Filtro espectral
proc.cdp.hilite_filter.desc = Filtra el análisis: pasa altos, pasa bajos, pasa banda o rechaza banda, con o sin ganancia. Programa CDP: hilite filter.
param.cdp.hilite_filter.modo = Modo
param.cdp.hilite_filter.modo.desc = Tipo de filtro.
param.cdp.hilite_filter.modo.1 = Pasa altos
param.cdp.hilite_filter.modo.2 = Pasa altos (normalizado)
param.cdp.hilite_filter.modo.3 = Pasa bajos
param.cdp.hilite_filter.modo.4 = Pasa bajos (normalizado)
param.cdp.hilite_filter.modo.5 = Pasa altos con ganancia
param.cdp.hilite_filter.modo.6 = Pasa bajos con ganancia
param.cdp.hilite_filter.modo.7 = Pasa banda
param.cdp.hilite_filter.modo.8 = Pasa banda (normalizado)
param.cdp.hilite_filter.modo.9 = Rechaza banda
param.cdp.hilite_filter.modo.10 = Rechaza banda (normalizado)
param.cdp.hilite_filter.modo.11 = Pasa banda con ganancia
param.cdp.hilite_filter.modo.12 = Rechaza banda con ganancia
param.cdp.hilite_filter.frec = Frecuencia
param.cdp.hilite_filter.frec.desc = Frecuencia de corte (o inicio de la banda).
param.cdp.hilite_filter.frec2 = Frecuencia 2
param.cdp.hilite_filter.frec2.desc = Final de la banda.
param.cdp.hilite_filter.q = Q
param.cdp.hilite_filter.q.desc = Pendiente del filtro.
param.cdp.hilite_filter.ganancia = Ganancia
param.cdp.hilite_filter.ganancia.desc = Ganancia de lo que pasa.
proc.cdp.spec_gain.nombre = Ganancia espectral
proc.cdp.spec_gain.desc = Sube o baja el nivel del análisis. Programa CDP: spec gain.
param.cdp.spec_gain.ganancia = Ganancia
param.cdp.spec_gain.ganancia.desc = Multiplicador del nivel (1 = igual).
proc.cdp.distort_average.nombre = Promediar ciclos
proc.cdp.distort_average.desc = Promedia la forma de onda sobre N ciclos: el sonido se vuelve más simple y áspero. Programa CDP: distort average.
param.cdp.distort_average.ciclos = Ciclos
param.cdp.distort_average.ciclos.desc = Sobre cuántos ciclos se promedia.
proc.cdp.distort_multiply.nombre = Multiplicar ciclos
proc.cdp.distort_multiply.desc = Multiplica la frecuencia de cada ciclo: armónicos agudos y sucios. Programa CDP: distort multiply.
param.cdp.distort_multiply.n = Multiplicador
param.cdp.distort_multiply.n.desc = Por cuánto se multiplica (2 a 16).
proc.cdp.modify_speed.nombre = Transponer velocidad
proc.cdp.modify_speed.desc = Cambia velocidad y altura juntas, como una cinta: más grave y más largo, o más agudo y más corto. Programa CDP: modify speed.
param.cdp.modify_speed.semitonos = Semitonos
param.cdp.modify_speed.semitonos.desc = Transposición (negativa: más grave y más largo).
proc.cdp.filter_lohi.nombre = Pasa bajos / altos
proc.cdp.filter_lohi.desc = Filtro fijo: si el corte está por encima del paso es pasa bajos; si está por debajo, pasa altos. Programa CDP: filter lohi.
param.cdp.filter_lohi.atenuacion = Atenuación
param.cdp.filter_lohi.atenuacion.desc = Cuánto se atenúa lo cortado (más: filtro más filoso).
param.cdp.filter_lohi.paso = Paso
param.cdp.filter_lohi.paso.desc = Última frecuencia que pasa.
param.cdp.filter_lohi.corte = Corte
param.cdp.filter_lohi.corte.desc = Primera frecuencia que se corta.

