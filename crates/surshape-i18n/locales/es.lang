param.nat.fundido.curva.exponencial = Exponencial
param.nat.fundido.curva.coseno = Coseno (suave)
proc.nat.polaridad.nombre = Invertir polaridad
proc.nat.polaridad.desc = Da vuelta la onda (arriba por abajo).
proc.nat.ganancia.nombre = Ganancia
