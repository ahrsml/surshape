proc.cdp.pvoc_anal.nombre = PVOC análisis
proc.cdp.pvoc_anal.desc = Pasa el sonido a análisis espectral (.ana), un archivo por canal. Programa CDP: pvoc anal.
proc.cdp.pvoc_synth.nombre = PVOC resíntesis
proc.cdp.pvoc_synth.desc = Vuelve de análisis espectral (.ana) a sonido. Programa CDP: pvoc synth.
