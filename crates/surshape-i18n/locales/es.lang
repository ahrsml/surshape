param.cdp.pvoc_anal.puntos = Puntos
param.cdp.pvoc_anal.puntos.desc = Tamaño del análisis: más puntos = más detalle en frecuencia y menos en el tiempo.
param.cdp.pvoc_anal.superposicion = Superposición
param.cdp.pvoc_anal.superposicion.desc = Cuánto se pisan las ventanas (1 a 4).
