# ── proc: processes ─────────────────────────────────────────────────────────
# [TÉRMINO] stretch / Paulstretch
proc.nat.paulstretch.nombre = Extreme stretch
proc.nat.paulstretch.desc = Stretches the sound 1 to 10,000 times without changing its pitch, Paulstretch style. Turns any sound into a slow, continuous texture.
proc.nat.reverse.nombre = Reverse
proc.nat.reverse.desc = Flips the sample: the end becomes the beginning.
# [TÉRMINO] bitcrush
proc.nat.bitcrush.nombre = Bitcrush
proc.nat.bitcrush.desc = Lowers resolution (bits) and sample rate: grainy, harsh digital distortion.
# [TÉRMINO] waveshaper
proc.nat.waveshaper.nombre = Random waveshaper
proc.nat.waveshaper.desc = Bends the waveform through a transfer curve generated from the seed. Every seed is a different distortion.
proc.nat.normalize.nombre = Normalize
proc.nat.normalize.desc = Raises or lowers the volume so the peak lands on the chosen level.

# [TÉRMINO] freeze
proc.nat.freeze.nombre = Spectral freeze
proc.nat.freeze.desc = Takes the spectrum of one instant of the sample and sustains it as long as you want: a frozen chord or noise, without attacks.
# [TÉRMINO] blur
proc.nat.spec_blur.nombre = Spectral blur
proc.nat.spec_blur.desc = Averages the spectrum over time: changes melt together and the sound becomes a diffuse cloud.
# [TÉRMINO] gate
proc.nat.spec_gate.nombre = Spectral gate
proc.nat.spec_gate.desc = Silences the weakest frequencies of each instant and keeps only the strong ones (or the reverse: only the residue).
proc.nat.spec_shift.nombre = Spectral shift
proc.nat.spec_shift.desc = Adds a fixed number of hertz to every frequency: harmonics stop being harmonic and the sound turns metallic.
proc.nat.spec_stretch.nombre = Spectral stretch
proc.nat.spec_stretch.desc = Spreads (or squeezes) the frequencies above an anchor: inharmonic timbres, bells, warped inner tuning.
# [TÉRMINO] bins
proc.nat.bin_shuffle.nombre = Bin shuffle
proc.nat.bin_shuffle.desc = Randomly swaps blocks of frequencies in each frame: the sound breaks into a tonal mosaic.
# [TÉRMINO] robotize
proc.nat.robotize.nombre = Robotize
proc.nat.robotize.desc = Imposes a fixed pitch: zeroes the phases and repeats each frame once per period. Robot voice, tonal buzz.
# [TÉRMINO] whisperize
proc.nat.whisperize.nombre = Whisperize
proc.nat.whisperize.desc = Replaces the phases with randomness using short windows: pitch disappears and a whisper with the original timbre remains.

# [TÉRMINO] blur blur (CDP program name)
proc.cdp.blur_blur.nombre = Blur
proc.cdp.blur_blur.desc = Averages the spectrum over several analysis windows: smooths changes and makes the sound diffuse. CDP program: blur blur.
# [TÉRMINO] focus accu (CDP program name)
proc.cdp.focus_accu.nombre = Spectral accumulate
proc.cdp.focus_accu.desc = Sustains each frequency band until something louder appears in it: trails, resonances that never die. CDP program: focus accu.
# [TÉRMINO] focus exag (CDP program name)
proc.cdp.focus_exag.nombre = Exaggerate contour
proc.cdp.focus_exag.desc = Exaggerates the shape of the spectrum: peaks sharpen and troughs deepen, or the reverse. CDP program: focus exag.
# [TÉRMINO] hilite trace (CDP program name)
proc.cdp.hilite_trace.nombre = Trace partials
proc.cdp.hilite_trace.desc = Keeps only the N strongest components of each window: the sound is reduced to its tonal skeleton. CDP program: hilite trace.
# [TÉRMINO] stretch time (CDP program name)
proc.cdp.stretch_time.nombre = Time stretch
proc.cdp.stretch_time.desc = Stretches or compresses the duration without changing pitch, using CDP's phase vocoder. CDP program: stretch time.
# [TÉRMINO] distort repeat (CDP program name)
proc.cdp.distort_repeat.nombre = Repeat cycles
proc.cdp.distort_repeat.desc = Repeats each wave cycle (or group of cycles) several times: lengthens the sound with a grainy, stuttering texture. CDP program: distort repeat.
# [TÉRMINO] distort fractal (CDP program name)
proc.cdp.distort_fractal.nombre = Cycle fractal
proc.cdp.distort_fractal.desc = Superimposes miniature copies of each wave cycle onto itself: aggressive brightness, fractal distortion. CDP program: distort fractal.
# [TÉRMINO] extend zigzag (CDP program name)
proc.cdp.extend_zigzag.nombre = Zigzag
proc.cdp.extend_zigzag.desc = Reads the sound back and forth at random inside a stretch, up to the requested length. Reproducible with the seed. CDP program: extend zigzag.

# [TÉRMINO] LFSR
proc.nat.noise.nombre = Noise
proc.nat.noise.desc = Generates noise with no input: white, pink, brown, dust (scattered clicks) or LFSR (digital, NES style). Reproducible with the seed.
proc.nat.granular.nombre = Granular
proc.nat.granular.desc = Builds the result from many short grains read from the input: clouds, textures, breathing freezes.
proc.nat.convolve.nombre = Convolution
proc.nat.convolve.desc = Uses another cell as the impulse response: reverb from a real space or timbre hybrids between two sounds.
proc.nat.cross_synth.nombre = Cross-synthesis
proc.nat.cross_synth.desc = Applies the timbre (amplitudes or spectral envelope) of another cell onto this sound: a voice speaking through wind noise.
# [TÉRMINO] combine cross
proc.cdp.combine_cross.nombre = Spectral cross
