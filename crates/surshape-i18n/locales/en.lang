proc.cdp.pvoc_anal.nombre = PVOC analysis
proc.cdp.pvoc_anal.desc = Turns sound into spectral analysis (.ana), one file per channel. CDP program: pvoc anal.
proc.cdp.pvoc_synth.nombre = PVOC resynthesis
proc.cdp.pvoc_synth.desc = Goes back from spectral analysis (.ana) to sound. CDP program: pvoc synth.
param.cdp.pvoc_anal.modo = Mode
param.cdp.pvoc_anal.modo.desc = What is kept from the analysis.
param.cdp.pvoc_anal.modo.1 = Full analysis
param.cdp.pvoc_anal.modo.2 = Spectral envelope only
param.cdp.pvoc_anal.puntos = Points
param.cdp.pvoc_anal.puntos.desc = Analysis size: more points = more frequency detail, less time detail.
param.cdp.pvoc_anal.superposicion = Overlap
param.cdp.pvoc_anal.superposicion.desc = How much windows overlap (1 to 4).
proc.nat.extraer.nombre = Extract (cut)
proc.nat.extraer.desc = Keeps only the chosen stretch (taken from the viewer selection).
param.nat.extraer.inicio = From
param.nat.extraer.inicio.desc = Start of the stretch.
param.nat.extraer.fin = To
param.nat.extraer.fin.desc = End of the stretch.
proc.nat.quitar.nombre = Trim (remove)
proc.nat.quitar.desc = Removes the chosen stretch and joins what comes before and after.
param.nat.quitar.inicio = From
param.nat.quitar.inicio.desc = Start of the stretch removed.
param.nat.quitar.fin = To
param.nat.quitar.fin.desc = End of the stretch removed.
proc.nat.silenciar.nombre = Silence selection
proc.nat.silenciar.desc = Silences the chosen stretch (length unchanged).
param.nat.silenciar.inicio = From
param.nat.silenciar.inicio.desc = Start of the silence.
param.nat.silenciar.fin = To
param.nat.silenciar.fin.desc = End of the silence.
proc.nat.fundido.nombre = Fades
proc.nat.fundido.desc = Fade in and fade out.
param.nat.fundido.entrada = Fade in
param.nat.fundido.entrada.desc = Fade-in length (0 = no fade).
param.nat.fundido.salida = Fade out
param.nat.fundido.salida.desc = Fade-out length (0 = no fade).
param.nat.fundido.curva = Curve
param.nat.fundido.curva.desc = Shape of the fade.
param.nat.fundido.curva.lineal = Linear
param.nat.fundido.curva.exponencial = Exponential
param.nat.fundido.curva.coseno = Cosine (smooth)
proc.nat.polaridad.nombre = Invert polarity
proc.nat.polaridad.desc = Flips the wave upside down.
proc.nat.ganancia.nombre = Gain
proc.nat.ganancia.desc = Raises or lowers the level in dB (can vary over time).
param.nat.ganancia.db = Gain
param.nat.ganancia.db.desc = Level change.

# --- Fase 6: ampliación del catálogo CDP ---
proc.cdp.blur_avrg.nombre = Average channels
proc.cdp.blur_avrg.desc = Averages each analysis channel's energy with its neighbours: a smoother, more diffuse spectrum. CDP program: blur avrg.
param.cdp.blur_avrg.n = Channels
param.cdp.blur_avrg.n.desc = How many neighbouring channels are averaged (an odd number is used).
proc.cdp.blur_suppress.nombre = Suppress partials
proc.cdp.blur_suppress.desc = Removes the N loudest partials in each window: the background, air and noise remain. CDP program: blur suppress.
param.cdp.blur_suppress.n = Partials
param.cdp.blur_suppress.n.desc = How many of the loudest partials are removed.
proc.cdp.strange_shift.nombre = Frequency shift
proc.cdp.strange_shift.desc = Adds a fixed number of Hz to the frequencies (whole spectrum or part of it): inharmonic, metallic sounds. CDP program: strange shift.
param.cdp.strange_shift.modo = Mode
param.cdp.strange_shift.modo.desc = Which part of the spectrum is shifted.
param.cdp.strange_shift.modo.1 = Whole spectrum
param.cdp.strange_shift.modo.2 = Above the divide
param.cdp.strange_shift.modo.3 = Below the divide
param.cdp.strange_shift.modo.4 = Inside a range
param.cdp.strange_shift.modo.5 = Outside a range
param.cdp.strange_shift.desplazamiento = Shift
param.cdp.strange_shift.desplazamiento.desc = Hz added (negative: downwards).
param.cdp.strange_shift.division = Divide
param.cdp.strange_shift.division.desc = Frequency where the shift starts or stops.
param.cdp.strange_shift.desde = From
param.cdp.strange_shift.desde.desc = Start of the range.
param.cdp.strange_shift.hasta = To
param.cdp.strange_shift.hasta.desc = End of the range.
proc.cdp.stretch_spectrum.nombre = Stretch partials
proc.cdp.stretch_spectrum.desc = Spreads or squeezes the partials above or below a frequency: harmonics turn into bells. CDP program: stretch spectrum.
param.cdp.stretch_spectrum.modo = Mode
param.cdp.stretch_spectrum.modo.desc = Which part of the spectrum is stretched.
param.cdp.stretch_spectrum.modo.1 = Above the divide
param.cdp.stretch_spectrum.modo.2 = Below the divide
param.cdp.stretch_spectrum.division = Divide
param.cdp.stretch_spectrum.division.desc = Frequency from which it stretches.
param.cdp.stretch_spectrum.maximo = Maximum stretch
param.cdp.stretch_spectrum.maximo.desc = Transposition of the topmost partials (1 = no change).
param.cdp.stretch_spectrum.exponente = Exponent
param.cdp.stretch_spectrum.exponente.desc = Shape of the stretch (1 = even).
param.cdp.stretch_spectrum.profundidad = Depth
param.cdp.stretch_spectrum.profundidad.desc = How much of the effect is applied (0 to 1).
proc.cdp.focus_fold.nombre = Fold spectrum
proc.cdp.focus_fold.desc = Octave-transposes every component into a range: a dense mass in one register. CDP program: focus fold.
param.cdp.focus_fold.desde = From
param.cdp.focus_fold.desde.desc = Low frequency of the range (at least one octave below the high one).
param.cdp.focus_fold.hasta = To
param.cdp.focus_fold.hasta.desc = High frequency of the range.
proc.cdp.hilite_filter.nombre = Spectral filter
proc.cdp.hilite_filter.desc = Filters the analysis: high pass, low pass, band pass or notch, with or without gain. CDP program: hilite filter.
param.cdp.hilite_filter.modo = Mode
param.cdp.hilite_filter.modo.desc = Filter type.
param.cdp.hilite_filter.modo.1 = High pass
param.cdp.hilite_filter.modo.2 = High pass (normalised)
param.cdp.hilite_filter.modo.3 = Low pass
param.cdp.hilite_filter.modo.4 = Low pass (normalised)
param.cdp.hilite_filter.modo.5 = High pass with gain
param.cdp.hilite_filter.modo.6 = Low pass with gain
param.cdp.hilite_filter.modo.7 = Band pass
param.cdp.hilite_filter.modo.8 = Band pass (normalised)
param.cdp.hilite_filter.modo.9 = Notch
param.cdp.hilite_filter.modo.10 = Notch (normalised)
param.cdp.hilite_filter.modo.11 = Band pass with gain
param.cdp.hilite_filter.modo.12 = Notch with gain
param.cdp.hilite_filter.frec = Frequency
param.cdp.hilite_filter.frec.desc = Cutoff frequency (or start of the band).
param.cdp.hilite_filter.frec2 = Frequency 2
param.cdp.hilite_filter.frec2.desc = End of the band.
param.cdp.hilite_filter.q = Q
param.cdp.hilite_filter.q.desc = Filter slope.
param.cdp.hilite_filter.ganancia = Gain
param.cdp.hilite_filter.ganancia.desc = Gain of what passes.
proc.cdp.spec_gain.nombre = Spectral gain
proc.cdp.spec_gain.desc = Raises or lowers the analysis level. CDP program: spec gain.
param.cdp.spec_gain.ganancia = Gain
param.cdp.spec_gain.ganancia.desc = Level multiplier (1 = same).
proc.cdp.distort_average.nombre = Average cycles
proc.cdp.distort_average.desc = Averages the waveform over N cycles: the sound becomes simpler and rougher. CDP program: distort average.
param.cdp.distort_average.ciclos = Cycles
param.cdp.distort_average.ciclos.desc = How many cycles are averaged.
proc.cdp.distort_multiply.nombre = Multiply cycles
proc.cdp.distort_multiply.desc = Multiplies each cycle's frequency: high, dirty harmonics. CDP program: distort multiply.
param.cdp.distort_multiply.n = Multiplier
param.cdp.distort_multiply.n.desc = Multiplied by (2 to 16).
proc.cdp.modify_speed.nombre = Speed transpose
proc.cdp.modify_speed.desc = Changes speed and pitch together, like tape: lower and longer, or higher and shorter. CDP program: modify speed.
param.cdp.modify_speed.semitonos = Semitones
param.cdp.modify_speed.semitonos.desc = Transposition (negative: lower and longer).
proc.cdp.filter_lohi.nombre = Low / high pass
proc.cdp.filter_lohi.desc = Fixed filter: a stop band above the pass band makes a low pass; below, a high pass. CDP program: filter lohi.
param.cdp.filter_lohi.atenuacion = Attenuation
param.cdp.filter_lohi.atenuacion.desc = How much the stop band is cut (more: sharper filter).
param.cdp.filter_lohi.paso = Pass band
param.cdp.filter_lohi.paso.desc = Last frequency that passes.
param.cdp.filter_lohi.corte = Stop band
param.cdp.filter_lohi.corte.desc = First frequency that is stopped.

